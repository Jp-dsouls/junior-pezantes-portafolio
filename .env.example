# Email Configuration
# Opción 1: Resend (Recomendado)
# Obtén tu API key en https://resend.com
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=tu-email@ejemplo.com

# Opción 2: Gmail SMTP
# EMAIL_USER=tu-email@gmail.com
# EMAIL_PASSWORD=tu-app-password-google

# Opción 3: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Opción 4: AWS SES
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# Analytics (Opcional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Vercel
VERCEL_URL=https://tu-portafolio.vercel.app

# Notas:
# 1. Copia este archivo a .env.local para desarrollo local
# 2. En Vercel, configura estas variables en Settings > Environment Variables
# 3. Solo necesitas configurar UNA opción de email
# 4. Las variables con NEXT_PUBLIC_ se exponen al cliente
# 5. Las variables sin NEXT_PUBLIC_ solo están disponibles en el servidor
